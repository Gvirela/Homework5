#include <iostream>

int main()
{
    int arr[3][6] = {{3, 6, 8, 2, 5, 90}, {34, 14, 7, 45, 108, 16}, {12, 5, 24, 8, 65, 7}};
    std::cout << "Array: " << std::endl;
    for (int i = 0; i < 3; i++)
    {
        for ( int j = 0; j < 6; j++)
        {
            std::cout << arr[i][j] << "\t";
        }
        std::cout << std::endl;
    }
    int min1 = 0;
    int min2 = 0;
    int max1 = 0;
    int max2 = 0;
    for (int i = 0 ; i < 3; i++)
    {
        for (int j = 0; j <6; j++)
        {
            if (arr[i][j] < arr[min1][min2])
            {
                min1 = i;
                min2 = j;
            }
            if (arr[i][j] > arr[max1][max2])
            {
                max1 = i;
                max2 = j;
            }
        }
    }
    std::cout << "Index of the minimum element: " << min1 << " " << min2 << std::endl;
    std::cout << "Index of the maximum element: " << max1 << " " << max2 << std::endl;
    return 0;

}
